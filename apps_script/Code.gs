
/** Apps Script backend — v6.2.2 (same endpoints as previous version) */
const PROP = PropertiesService.getScriptProperties();
function _json(res, status=200, origin='*'){return ContentService.createTextOutput(JSON.stringify(res)).setMimeType(ContentService.MimeType.JSON).setHeader('Access-Control-Allow-Origin', origin).setHeader('Access-Control-Allow-Methods','POST, GET, OPTIONS').setHeader('Access-Control-Allow-Headers','Content-Type, x-wa-token');}
function doOptions(e){return _json({ok:true},200,e?.parameter?.origin||'*');}
function doGet(e){return _json({ok:true,ts:new Date().toISOString()},200,e?.parameter?.origin||'*');}
function doPost(e){try{const origin=e?.parameter?.origin||'*';const body=JSON.parse(e.postData.contents||'{}');const token=body.token||(e?.headers&&e.headers['x-wa-token'])||'';const adm=PROP.getProperty('ADMIN_TOKEN')||'';if(!adm) return _json({ok:false,error:'ADMIN_TOKEN not set'},500,origin);if(token!==adm) return _json({ok:false,error:'unauthorized'},401,origin);const sheetId=PROP.getProperty('SHEET_ID');if(!sheetId) return _json({ok:false,error:'SHEET_ID not set'},500,origin);const ss=SpreadsheetApp.openById(sheetId);const A=(n,h)=>{let s=ss.getSheetByName(n);if(!s){s=ss.insertSheet(n);if(h?.length)s.getRange(1,1,1,h.length).setValues([h]);}return s;};const rows=n=>{const s=ss.getSheetByName(n);if(!s)return[];const v=s.getDataRange().getValues();if(v.length<2)return[];const head=v[0];return v.slice(1).filter(r=>r.some(x=>x!==''&&x!=null)).map(r=>Object.fromEntries(head.map((h,i)=>[h,r[i]])));};const find=(n,k,val)=>{const s=ss.getSheetByName(n);if(!s)return-1;const v=s.getDataRange().getValues();if(v.length<2)return-1;const head=v[0];const idx=head.indexOf(k);for(let i=1;i<v.length;i++){if(String(v[i][idx])===String(val))return i;}return-1;};const ap=(n,h,o)=>{const s=A(n,h);s.appendRow(h.map(k=>o[k]));};const act=body.action;switch(act){case 'siteData':return _json({ok:true,products:rows('Products'),documents:rows('Documents'),priceChanges:rows('PriceChanges'),gallery:rows('Gallery')});case 'listProducts':return _json({ok:true,rows:rows('Products')});case 'upsertProduct':{const p=body.product;const h=['sku','name','price','summary','description','imageUrl','trialUrl','docUrl','active'];const s=A('Products',h);const i=find('Products','sku',p.sku);const obj={sku:String(p.sku),name:p.name||'',price:Number(p.price)||0,summary:p.summary||'',description:p.description||'',imageUrl:p.imageUrl||'',trialUrl:p.trialUrl||'',docUrl:p.docUrl||'',active:(p.active===true||p.active==='true')};if(i>0)s.getRange(i,1,1,h.length).setValues([[obj.sku,obj.name,obj.price,obj.summary,obj.description,obj.imageUrl,obj.trialUrl,obj.docUrl,obj.active]]);else ap('Products',h,obj);return _json({ok:true});}case 'deleteProduct':{const s=ss.getSheetByName('Products');if(!s)return _json({ok:true});const i=find('Products','sku',body.sku);if(i>0)s.deleteRow(i);return _json({ok:true});}case 'listGallery':return _json({ok:true,rows:rows('Gallery')});case 'upsertGallery':{const g=body.item;const h=['imageUrl','alt','caption','uploadedAt'];const s=A('Gallery',h);const i=find('Gallery','imageUrl',g.imageUrl);const obj={imageUrl:String(g.imageUrl),alt:g.alt||'',caption:g.caption||'',uploadedAt:new Date()};if(i>0)s.getRange(i,1,1,h.length).setValues([[obj.imageUrl,obj.alt,obj.caption,obj.uploadedAt]]);else ap('Gallery',h,obj);return _json({ok:true});}case 'deleteGallery':{const s=ss.getSheetByName('Gallery');if(!s)return _json({ok:true});const i=find('Gallery','imageUrl',body.imageUrl);if(i>0)s.deleteRow(i);return _json({ok:true});}default:return _json({ok:false,error:'unknown action'},400)}}catch(err){return _json({ok:false,error:String(err)},500,'*')}}
