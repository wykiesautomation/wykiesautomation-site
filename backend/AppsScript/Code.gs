
const CFG={SHEET_ID:PropertiesService.getScriptProperties().getProperty('CMS_SHEET_ID')||'12qRMe6pAPVaQtosZBnhVtpMwyNks7W8uY9PX1mF620k',ALLOW_EMAIL:PropertiesService.getScriptProperties().getProperty('ALLOW_EMAIL')||'wykiesautomation@gmail.com',ADMIN_PASS_HASH:PropertiesService.getScriptProperties().getProperty('ADMIN_PASS_HASH')||'',ADMIN_PASS_SALT:PropertiesService.getScriptProperties().getProperty('ADMIN_PASS_SALT')||'',GOOGLE_AUDS:(PropertiesService.getScriptProperties().getProperty('GOOGLE_CLIENT_IDS')||'291364861368-vskn09o73106qa9rqrt4bhbhif87vdim.apps.googleusercontent.com').split(','),PAYFAST_PASSPHRASE:PropertiesService.getScriptProperties().getProperty('PAYFAST_PASSPHRASE')||'',PAYFAST_MERCHANT_ID:PropertiesService.getScriptProperties().getProperty('PAYFAST_MERCHANT_ID')||'',PAYFAST_MERCHANT_KEY:PropertiesService.getScriptProperties().getProperty('PAYFAST_MERCHANT_KEY')||''};
function sheet(n){return SpreadsheetApp.openById(CFG.SHEET_ID).getSheetByName(n)}
function J(o){return ContentService.createTextOutput(typeof o==='string'?o:JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
function h256(s){const b=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s);return b.map(x=>('0'+(x&255).toString(16)).slice(-2)).join('')}
function doGet(e){const a=(e&&e.parameter&&e.parameter.action)||'ping';if(a==='list_products'){const sh=sheet('Products');if(!sh)return J({items:[]});const rows=sh.getDataRange().getValues();const head=rows.shift();const idx=Object.fromEntries(head.map((h,i)=>[String(h).trim(),i]));const items=rows.filter(r=>r[idx['sku']]).map(r=>({id:r[idx['sku']],name:r[idx['name']],price_vat_incl:Number(r[idx['price']]),short:r[idx['summary']],description:r[idx['description']],images:[r[idx['imageUrl']]],trialUrl:r[idx['trialUrl']]||null,docUrl:r[idx['docUrl']]||null,published:String(r[idx['active']]).toLowerCase()==='true'}));return J({items})}return J({status:'ok'})}
function doPost(e){const a=(e&&e.parameter&&e.parameter.action)||'';const body=e.postData&&e.postData.contents?JSON.parse(e.postData.contents):{};if(a==='prepare_payfast'){const sku=body.sku||'';const qty=Number(body.qty||1);const returnUrl=body.returnUrl||'';const name=body.name||'';const email=body.email||CFG.ALLOW_EMAIL;const sh=sheet('Products');const rows=sh.getDataRange().getValues();const head=rows.shift();const idx=Object.fromEntries(head.map((h,i)=>[String(h).trim(),i]));const row=rows.find(r=>r[idx['sku']]==sku);const price=row?Number(row[idx['price']]):0;const amount=(price*qty).toFixed(2);const fields={merchant_id:CFG.PAYFAST_MERCHANT_ID,merchant_key:CFG.PAYFAST_MERCHANT_KEY,return_url:returnUrl,cancel_url:returnUrl,notify_url:ScriptApp.getService().getUrl()+'?action=itn_payfast',name_first:name.split(' ')[0]||'Customer',name_last:name.split(' ').slice(1).join(' ')||' ',email_address:email,m_payment_id:Utilities.getUuid(),amount:amount,item_name:sku};const pfString=Object.keys(fields).sort().map(k=>k+'='+encodeURIComponent(fields[k]).replace(/%20/g,'+')).join('&');const sig=h256(pfString+(CFG.PAYFAST_PASSPHRASE?'&passphrase='+encodeURIComponent(CFG.PAYFAST_PASSPHRASE):''));const html='<form id="pf" action="https://www.payfast.co.za/eng/process" method="post">'+Object.keys(fields).map(k=>`<input type="hidden" name="${k}" value="${fields[k]}">`).join('')+`<input type="hidden" name="signature" value="${sig}"></form><script>document.getElementById('pf').submit()</script>`;return J(html)} if(a==='itn_payfast'){return J({status:'ok'})} return J({status:'error'})}
